generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String?
  name      String?
  googleId  String?   @unique
  role      Role      @default(CLIENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  messages  Message[]
  orders    Order[]
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  plan            String
  status          OrderStatus @default(PENDING)
  requirements    Json?
  timeline        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deliveryDate    DateTime?
  discountCode    String?
  price           Float       @default(0)
  referenceImages Json?
  messages        Message[]
  user            User        @relation(fields: [userId], references: [id])
  project         Project?
}

model DiscountCode {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  percentage Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  senderId  Int
  orderId   Int
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  imageUrl  String?
  order     Order    @relation(fields: [orderId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
}

model Project {
  id               Int      @id @default(autoincrement())
  orderId          Int      @unique
  url              String?
  adminPanelUrl    String?
  documentationUrl String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  adminPassword    String?
  adminUsername    String?
  name             String?
  order            Order    @relation(fields: [orderId], references: [id])
}

model Plan {
  id                     Int      @id @default(autoincrement())
  name                   String
  slug                   String   @unique
  tagline                String?
  description            String
  detailedDescription    String?
  price                  Float
  setupPrice             Float    @default(0)
  monthlyPrice           Float    @default(0)
  price_detail           String?
  features               Json
  whatYouGet             Json?
  useCases               Json?
  management             Json?
  considerations         Json?
  recommendations        Json?
  demos                  Json?
  popular                Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  description_en         String?
  detailedDescription_en String?
  tagline_en             String?
}


model ExampleProject {
  id                     Int      @id @default(autoincrement())
  title                  String
  slug                   String   @unique
  tagline                String?
  description            String
  detailedDescription    String?
  imageUrl               String
  category               String
  url                    String?
  features               Json?
  technologies           Json?
  client                 String?
  completionDate         String?
  testimonial            Json?
  gallery                Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  description_en         String?
  detailedDescription_en String?
  tagline_en             String?
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PersonalData {
  id        Int      @id @default(autoincrement())
  email     String
  phone     String?
  address   String?
  city      String?
  country   String?
  updatedAt DateTime @default(now()) @updatedAt
  facebook  String?
  instagram String?
  linkedin  String?
  twitter   String?
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PAYMENT_PENDING
  IN_PROGRESS
  FINISHED
}
